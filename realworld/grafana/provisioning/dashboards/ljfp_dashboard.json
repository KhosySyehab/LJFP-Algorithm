        {"datasource":{"type":"prometheus","uid":"Prometheus"},
          "expr":"sum(rate(container_cpu_usage_seconds_total{id=~\"/docker.*\",id!=\"/docker\",id!=\"/docker/buildx\"}[30s])) by (id) * 100",
